# --- Firebase Config ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Firebase config (server-side) ---
FIREBASE_ADMIN_PRIVATE_KEY=your_firebase_admin_private_key
FIREBASE_ADMIN_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_ADMIN_PROJECT_ID=your_firebase_admin_project_id
# Tests E2E uniquement, sans protocole : 127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- SENTRY ---
SENTRY_DSN=url_sentry

# --- API BACK ---
# URL serveur du backend Vasco. Ne jamais utiliser cette variable dans un composant client.
# Origine FastAPI uniquement, sans /api/v1 (ex. http://localhost:8080)
VASCO_API_URL=http://localhost:8080

# --- HOSTNAME BUCKET S3 ---
# Hostname exact produit par boto3, sans protocole
NEXT_PUBLIC_BUCKET_HOSTNAME=nom_bucket.s3.amazonaws.com

# --- METEO MET NORWAY ---
# Surcharge optionnelle de l'identification serveur par défaut : nom/version + URL ou e-mail de contact public.
WEATHER_USER_AGENT=VascoWeb/1.0 github.com/FievezRomain/dailybook_web
# Base d’un proxy de géocodage compatible Nominatim (optionnel).
# GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
